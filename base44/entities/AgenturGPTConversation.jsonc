{
  "name": "AgenturGPTConversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titel des Gespr\u00e4chs"
    },
    "messages": {
      "type": "string",
      "description": "JSON-String der Nachrichten"
    },
    "folder_id": {
      "type": "string",
      "description": "Optionale Ordner-ID (lokal)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "deep_research"
      ],
      "default": "normal",
      "description": "Recherche-Modus"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}