{
  "name": "NoteComment",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "string",
      "description": "ID der zugeh\u00f6rigen Notiz"
    },
    "content": {
      "type": "string",
      "description": "Kommentartext"
    }
  },
  "required": [
    "note_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}