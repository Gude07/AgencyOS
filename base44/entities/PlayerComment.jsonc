{
  "name": "PlayerComment",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "ID des Spielers"
    },
    "content": {
      "type": "string",
      "description": "Kommentartext"
    },
    "parent_id": {
      "type": "string",
      "description": "ID des \u00fcbergeordneten Kommentars (f\u00fcr Antworten)"
    }
  },
  "required": [
    "player_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}