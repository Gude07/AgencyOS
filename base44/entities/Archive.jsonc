{
  "name": "Archive",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "ID der Agentur"
    },
    "name": {
      "type": "string",
      "description": "Name des Archiv-Ordners"
    },
    "type": {
      "type": "string",
      "enum": [
        "player",
        "club"
      ],
      "description": "Typ des Archivs (Spieler oder Verein)"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung des Archivs"
    }
  },
  "required": [
    "agency_id",
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.agency_id": "{{user.data.agency_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.agency_id": "{{user.data.agency_id}}"
    },
    "update": {
      "$or": [
        {
          "data.agency_id": "{{user.data.agency_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.agency_id": "{{user.data.agency_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}