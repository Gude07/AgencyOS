{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Benutzerrolle"
    },
    "agency_id": {
      "type": "string",
      "description": "ID der aktuell ausgew\u00e4hlten Agentur (\u00e4ndert sich beim Agentur-Wechsel)"
    },
    "home_agency_id": {
      "type": "string",
      "description": "ID der Stamm-Agentur des Benutzers (\u00e4ndert sich nicht beim Agentur-Wechsel, wird f\u00fcr Online-Status verwendet)"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Letzter Zeitstempel der Online-Aktivit\u00e4t"
    },
    "favorite_players": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs der favorisierten Spieler"
    },
    "favorite_club_requests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs der favorisierten Vereinsanfragen"
    }
  },
  "required": [
    "agency_id"
  ]
}