{
  "name": "Comment",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID der zugeh\u00f6rigen Aufgabe"
    },
    "content": {
      "type": "string",
      "description": "Kommentartext"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "E-Mails von erw\u00e4hnten Personen"
    }
  },
  "required": [
    "task_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}